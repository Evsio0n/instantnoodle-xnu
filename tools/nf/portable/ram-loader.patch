+/* USB state from the existing UEFI event pump. The kernel takes only an
+ * atomic snapshot of the generation and cable state published by this core. */
+static void portable_usb_update(void)
+{
+	if (running_live && running_live->portable_magic == 0x3154524f504b4848ULL) {
+		struct kernel_live *live = (struct kernel_live *)(uintptr_t)running_live;
+		uint64_t previous = live->portable_usb;
+		if (previous == 0 || (previous & 1) != (unsigned)usb_connected)
+			__atomic_store_n(&live->portable_usb,
+			    ((previous & ~1ULL) + 2) | (unsigned)usb_connected, __ATOMIC_RELEASE);
+	}
+}
