+static uint64_t
+hk_awdl_client_id(void)
+{
+	return proc_uniqueid(current_proc());
+}
+
+static bool
+hk_awdl_name_attached(const char *name)
+{
+	ifnet_t interface = NULL;
+	if (ifnet_find_by_name(name, &interface) || interface == NULL) {
+		return false;
+	}
+	ifnet_release(interface);
+	return true;
+}
+
+static bool
+hk_awdl_address_matches(const char *name, const uint8_t requested[6])
+{
+	ifnet_t interface = NULL;
+	uint8_t actual[6];
+	if (ifnet_find_by_name(name, &interface) || interface == NULL)
+		return false;
+	int error = ifnet_lladdr_copy_bytes(interface, actual, sizeof(actual));
+	ifnet_release(interface);
+	printf("awdl-create: explicit address match=%u\n", !error && !memcmp(actual, requested, 6));
+	return !error && !memcmp(actual, requested, 6);
+}
