+	if (strnstr(p->p_comm, "BlastDoo", sizeof(p->p_comm)) == NULL &&
+	    !minisandbox_p2p_profile(p)) {
 		return 0;
 	}
 	if (copyin(arg, &a, sizeof(a)) != 0 || a.operation != 0 || a.answer == 0 || (pid_t)a.pid != proc_getpid(p)) {
@@ -252,8 +281,7 @@
