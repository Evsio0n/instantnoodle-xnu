 #define SANDBOX_SYSCALL_CHECK           2
 
+/* Limited native P2P profile for this port. The same predicate selects
+ * the enforced MAC hooks and the result of the membership query. */
+extern kern_return_t miniamfi_entitlement_string(struct proc *, const char *, const char *);
+static bool
+minisandbox_p2p_profile(proc_t p)
+{
+	return miniamfi_entitlement_string(p, "com.apple.private.sandbox.profile:embedded",
+	           "wifip2pd") == KERN_SUCCESS;
+}
+
+static int
+minisandbox_p2p_system_change(kauth_cred_t cred)
+{
+	return cred == kauth_cred_get() && minisandbox_p2p_profile(current_proc()) ? EPERM : 0;
+}
+
+static int
+minisandbox_p2p_reboot(kauth_cred_t cred, __unused int howto)
+{
+	return minisandbox_p2p_system_change(cred);
+}
+
+static int
+minisandbox_p2p_debug(kauth_cred_t cred, __unused struct proc_ident *target)
+{
+	return minisandbox_p2p_system_change(cred);
+}
+
 static int
