--- a/src/freedreno/vulkan/tu_hackios.cc
+++ b/src/freedreno/vulkan/tu_hackios.cc
@@ -0,0 +1,53 @@
+/*
+ * Copyright © 2026 Darwin on redwood contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * What the Metal back end over Vulkan (src/compiler/air/air_vk.c, HackiOS's
+ * tools/mesa/air/air_vk.c) needs from turnip and cannot get through the Vulkan API:
+ * the NIR compiler options turnip's own shaders are made with.
+ *
+ * WHY THIS IS NEEDED AT ALL. air_vk.c hands turnip NIR rather than SPIR-V -- the AIR
+ * frontend makes NIR, and VkPipelineShaderStageNirCreateInfoMESA (vk_pipeline.h) is the
+ * Vulkan runtime's own door for it, the one vk_meta.c uses. That door has one condition
+ * that is not visible in any Vulkan structure: the shader's `options` must be the very
+ * options the driver compiles with. vk_pipeline_shader_stage_to_nir clones the shader
+ * and asserts
+ *
+ *     assert(clone->options == NULL || clone->options == nir_options);
+ *
+ * and then overwrites the pointer anyway. Asserts are compiled out of this build, so a
+ * shader made with other options would not be refused -- it would be COMPILED, having
+ * been translated under different promises about what the backend lowers (which ALU
+ * ops it has, whether it wants vertex ids zero-based, what it does with fp64...). That
+ * is a wrong shader that looks right, so the options are taken from turnip itself, by
+ * the same call tu_shader.cc makes (tu_spirv_to_nir: ir3_get_compiler_options of the
+ * device's compiler).
+ *
+ * WHY A VkDevice AND NOT A VkPhysicalDevice. turnip makes its ir3 compiler in
+ * tu_CreateDevice (tu_device.cc, `device->compiler = ir3_compiler_create(...)`), with
+ * per-device options (push_ubo_with_preamble, shared_push_consts and the storage bits),
+ * so there is no compiler, and no options, before there is a device. The options are
+ * one struct for every stage: ir3_get_compiler_options takes no stage.
+ *
+ * It is C linkage and hidden like everything else of turnip's: air_vk.c is linked into
+ * this same library, so nothing outside it needs to see this.
+ */
+
+#include "tu_device.h"
+
+#include "ir3/ir3_compiler.h"
+
+extern "C" const struct nir_shader_compiler_options *
+tu_hackios_nir_options(VkDevice device);
+
+extern "C" const struct nir_shader_compiler_options *
+tu_hackios_nir_options(VkDevice device)
+{
+   VK_FROM_HANDLE(tu_device, dev, device);
+
+   if (dev == NULL || dev->compiler == NULL)
+      return NULL;
+   return ir3_get_compiler_options(dev->compiler);
+}
--- a/src/freedreno/vulkan/tu_hackios_exports.txt
