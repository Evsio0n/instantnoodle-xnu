+# What libvulkan_freedreno.dylib exports on Darwin, and nothing else: ld64's
+# -exported_symbols_list (meson.build). Mach-O names, so each has its leading underscore.
+#
+# The library is built -fvisibility=hidden already, which today leaves exactly the three
+# vk_icd* entry points global. This list makes that a property of the link instead of a
+# property of every header in Mesa: NIR, util, ir3 and turnip are linked in whole, and one
+# of them marking a symbol default would otherwise export it -- and a second copy of NIR
+# visible in a process that already holds libhackiosair.dylib's is the kind of collision
+# that binds a call to the wrong copy without saying so.
+#
+# The ICD entry points, as a Vulkan loader (or userland/src/vk_test.c) looks them up:
+_vk_icdGetInstanceProcAddr
+_vk_icdGetPhysicalDeviceProcAddr
+_vk_icdNegotiateLoaderICDInterfaceVersion
+#
+# The Metal driver's contract over Vulkan (src/compiler/air/air_vk.c, the calls of
+# air_metal.h), which userland/src/hkmetal.m looks up by name when metal_backend=vk:
+_rwa_argbuf_encode_buffer
+_rwa_argbuf_encode_sampler
+_rwa_argbuf_encode_texture
+_rwa_argbuf_encoded_members
+_rwa_buffer_create
+_rwa_buffer_destroy
+_rwa_buffer_map
+_rwa_buffer_size
+_rwa_clear_color
+_rwa_clear_depth_stencil
+_rwa_compute_create
+_rwa_compute_destroy
+_rwa_copy_buffer
+_rwa_copy_buffer_to_texture
+_rwa_copy_texture
+_rwa_copy_texture_to_buffer
+_rwa_depth_read
+_rwa_depth_stencil_create
+_rwa_depth_stencil_destroy
+_rwa_device_close
+_rwa_device_defer_waits
+_rwa_device_name
+_rwa_device_open
+_rwa_dispatch
+_rwa_dispatch_buffers
+_rwa_fence_release
+_rwa_fence_wait
+_rwa_fill_buffer
+_rwa_finish
+_rwa_flush
+_rwa_generate_mipmaps
+_rwa_module_argbufs
+_rwa_module_textures
+_rwa_render_create
+_rwa_render_destroy
+_rwa_render_draw
+_rwa_resolve_texture
+_rwa_sampler_create
+_rwa_sampler_destroy
+_rwa_texture_create
+_rwa_texture_destroy
+_rwa_texture_from_surface
+_rwa_texture_read
+_rwa_texture_view_create
+_rwa_compute_create_constants
+_rwa_module_function_constants
+_rwa_texture_write
+#
+# Not part of air_metal.h: air_vk.c's counts of command buffers, fences, buffers and
+# images in use, for a test to print (userland/src/metal_drv_test.m).
+_rwa_vk_counts
