+
+/* HackiOS (K40): every BO of the device by the name it was made under, the biggest first, in MB: what a process's
+ * live Metal objects do not explain. Through rwa_vk_memory (air_vk.c). */
+extern "C" int
+tu_hackios_bos(VkDevice device, char *text, size_t size);
+
+extern "C" int
+tu_hackios_bos(VkDevice device, char *text, size_t size)
+{
+   VK_FROM_HANDLE(tu_device, dev, device);
+   const struct tu_debug_bos_entry *top[8] = { NULL };
+   uint64_t bytes = 0;
+   uint32_t count = 0;
+   int said;
 
+   mtx_lock(&dev->bo_mutex);
+   hash_table_foreach(dev->bo_sizes, entry)
+   {
+      const struct tu_debug_bos_entry *e = (const struct tu_debug_bos_entry *) entry->data;
+
+      bytes += e->size;
+      count += e->count;
+      for (unsigned i = 0; i < ARRAY_SIZE(top); i++) {
+         if (!top[i] || e->size > top[i]->size) {
+            memmove(&top[i + 1], &top[i], (ARRAY_SIZE(top) - i - 1) * sizeof(top[0]));
+            top[i] = e;
+            break;
+         }
+      }
+   }
+   said = snprintf(text, size, "BOs %u, %llu MB:", count, (unsigned long long) (bytes >> 20));
+   for (unsigned i = 0; i < ARRAY_SIZE(top) && top[i] && said >= 0 && (size_t) said < size; i++) {
+      said += snprintf(text + said, size - said, " %s %u/%llu", top[i]->name, top[i]->count,
+                       (unsigned long long) (top[i]->size >> 20));
+   }
    mtx_unlock(&dev->bo_mutex);
+   return said;
 }
 
